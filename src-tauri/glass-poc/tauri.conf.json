{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceFlow Native Glass PoC",
  "version": "0.1.4",
  "identifier": "com.voiceflow.desktop.native-glass-poc",
  "build": {
    "devUrl": "http://127.0.0.1:14217",
    "frontendDist": "../../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "island",
        "title": "VoiceFlow Native Glass PoC",
        "url": "island.html?native-glass-poc=1",
        "width": 244,
        "height": 64,
        "transparent": true,
        "shadow": false,
        "decorations": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focusable": false,
        "acceptFirstMouse": true,
        "resizable": false,
        "visible": false,
        "incognito": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        {
          "identifier": "native-glass-poc",
          "windows": ["island"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:event:allow-emit"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ]
  }
}
