{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceFlow",
  "version": "0.1.4",
  "identifier": "com.voiceflow.desktop",
  "build": {
    "beforeDevCommand": "bash \"${PWD%/src-tauri}/src-tauri/mlx-sidecar/scripts/package.sh\" --dev && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && bash \"${PWD%/src-tauri}/src-tauri/mlx-sidecar/scripts/package.sh\"",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "VoiceFlow 设置",
        "width": 1035,
        "height": 750,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 16 },
        "visible": false
      },
      {
        "label": "island",
        "title": "VoiceFlow",
        "url": "island.html",
        "width": 172,
        "height": 68,
        "transparent": true,
        "shadow": false,
        "decorations": false,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focusable": false,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "target/mlx-sidecar/stage/": "",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/": "resources/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
