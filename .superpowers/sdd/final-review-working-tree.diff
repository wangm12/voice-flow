+fn history_encryption_key_for_write() -> anyhow::Result<[u8; 32]> {
+    if let Some(key) = crate::keychain::get_history_key().map_err(anyhow::Error::msg)? {
+        return key
+            .try_into()
+            .map_err(|_| anyhow::anyhow!("stored history key must be exactly 32 bytes"));
